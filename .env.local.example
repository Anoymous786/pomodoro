# LLM provider for the roadmap generator.
# Choose "grok" or "gemini". Switching providers only changes this value.
LLM_PROVIDER=grok

# API key for the Grok provider (xAI).
# Used when LLM_PROVIDER=grok
GROQ_API_KEY=your_groq_api_key_here

# API key for the Gemini provider (Google AI Studio).
# Used when LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here